# Copy to scripts/.env.ftps and fill in. Never commit .env.ftps.
FTPS_HOST=wp11076001.server-he.de
FTPS_PORT=21
FTPS_USER=ftp11076001-ernst
FTPS_PASS=
# Kirby web root on the FTP account (empty = FTP login root)
FTPS_REMOTE_ROOT=
