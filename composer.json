{
  "name": "berlintiger/website",
  "description": "Website von Berlin Tiger – Basketball in Kreuzberg e.V. (Kirby CMS)",
  "type": "project",
  "keywords": [
    "kirby",
    "berlin-tiger"
  ],
  "authors": [
    {
      "name": "Ernst Wolf"
    }
  ],
  "homepage": "https://berlintiger.de",
  "require": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
    "getkirby/cms": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 kirby/router.php"
    ]
  }
}
